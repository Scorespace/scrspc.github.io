---
// Every game ScoreSpace publishes, then how a jam game gets published, in the homepage's look.
import GamesAccordion from '../components/GamesAccordion.astro';
import Page from '../layouts/Page.astro';
import { brand } from '../data/brand';

const discord = brand.social.find((s) => s.label === 'Discord')!.url;
const steps = [
  ['Join a Jam', 'Participate in one of our monthly game jams with unique themes'],
  ['Create a Game', 'Build something awesome within the jam timeframe'],
  ['Get Noticed', 'Outstanding games catch our attention through community voting'],
  ['Get Published', "We'll reach out to help polish and publish your game"],
];
---

<Page
  title="Games - ScoreSpace"
  description="Play games created by ScoreSpace."
  heading="Games"
  subtitle="Games that started in our gamejam events that went on to be published by ScoreSpace."
>
  <GamesAccordion all label="All Games" flush />

  <section class="publish" aria-labelledby="publish-title">
    <h2 id="publish-title">How to Get Published</h2>
    <p class="intro">ScoreSpace discovers and publishes games from our monthly jams. Here's how it works:</p>
    <ol class="steps">
      {steps.map(([name, line], i) => (
        <li>
          <span class="no">{String(i + 1).padStart(2, '0')}</span>
          <h3>{name}</h3>
          <p>{line}</p>
        </li>
      ))}
    </ol>
    <a class="pill" href={discord} target="_blank" rel="noopener">Join Discord for More Info <span class="arrow" aria-hidden="true">↗</span></a>
  </section>

  <section class="more" aria-labelledby="more-title">
    <h2 id="more-title">Looking for more games?</h2>
    <p>
      Check out the thousands of games submitted to our game jams on itch.io.
      Each jam features unique themes and creative submissions from developers worldwide.
    </p>
    <a class="pill" href="https://itch.io/jams/hosted-by-scorespace" target="_blank" rel="noopener">Browse Jam Submissions <span class="arrow" aria-hidden="true">↗</span></a>
  </section>
</Page>

<style>
  .publish,
  .more { margin-top: clamp(56px, 10vh, 112px); }
  h2 { margin: 0; font-weight: 500; font-size: clamp(24px, 2.6vw, 34px); letter-spacing: -0.02em; color: var(--bright); }
  .intro,
  .more p { margin-top: 12px; max-width: 60ch; color: var(--muted); font-size: 17px; }
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin: 28px 0;
    padding: 0;
    list-style: none;
  }
  .steps li { padding: 22px; border-radius: 24px; background: var(--wash); box-shadow: inset 0 0 0 1px var(--edge); }
  .no { color: var(--accent); font-size: 14px; font-variant-numeric: tabular-nums; }
  h3 { margin: 14px 0 6px; font-weight: 500; font-size: 18px; color: var(--ink); }
  .steps p { color: var(--muted); font-size: 15px; }
  .more .pill { margin-top: 24px; }
  @media (max-width: 900px) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
