---
// B1, format: Scoreboard. The numbers are a high-score table that rolls up like
// an odometer, and the last row, yours, is the way in. Above it, five arcade
// cabinets take turns playing breakout, pong, snake, invaders and stacker; on
// narrow screens one big cabinet plays them all in turn.
import '../../styles/soft.css';
import HairlineFigure from '../../components/HairlineFigure.astro';
import PickerBridge from '../../components/PickerBridge.astro';
import SoftChrome from '../../components/SoftChrome.astro';
import Minimal from '../../layouts/Minimal.astro';
import { brand, description, title } from '../../data/brand';

const scores = [
  { rank: '1st', name: 'Players', note: `${brand.publishing.line}, across all platforms`, score: brand.publishing.long },
  { rank: '2nd', name: 'Games submitted', note: 'All time, across every jam', score: brand.jams.stat },
  { rank: '3rd', name: 'Jamming since', note: "We've been running game jams the whole time", score: String(brand.jams.since) },
];
// Each digit becomes a strip of 0–9 three times over, so it rolls two full turns before landing.
const strip = (ch: string) => (/\d/.test(ch) ? Number(ch) : null);
---

<Minimal
  title={title}
  description={description}
  noindex
  theme="dark"
  fonts="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500&display=swap"
>
  <SoftChrome part="top" />

  <main class="wrap">
    <section class="hero">
      <div class="copy">
        <p class="label" data-reveal>High scores <span class="dot" aria-hidden="true"></span> since {brand.jams.since}</p>
        <h1 class="statement" data-reveal>{brand.statement}</h1>
        <a class="pill solid start" href={brand.events.url} target="_blank" rel="noopener" data-reveal>
          Press start <span class="arrow right" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="figure" data-reveal>
        <HairlineFigure
          name="arcade-row"
          class="wide-only"
          theme="dark"
          play={false}
          label="Five arcade cabinets taking turns to play breakout, pong, snake, invaders and stacker."
        />
        <HairlineFigure
          name="arcade-solo"
          class="narrow-only"
          theme="dark"
          play={false}
          label="An arcade cabinet that changes game every few seconds: breakout, pong, snake, invaders, stacker."
        />
        <p class="hint">
          <span class="wide-only">Breakout, pong, snake, invaders, stacker. Hover a cabinet to keep it playing.</span>
          <span class="narrow-only">Five games, one cabinet. Touch it to keep the game on.</span>
        </p>
      </div>
    </section>

    <section class="board" aria-label="High scores">
      <div class="board-head" data-reveal>
        <span>Rank</span><span>Name</span><span class="right">Score</span>
      </div>
      {scores.map((s) => (
        <div class="row" data-reveal>
          <span class="rank">{s.rank}</span>
          <span class="name">{s.name}<small>{s.note}</small></span>
          <span class="score" aria-label={s.score}>
            {[...s.score].map((ch) => {
              const d = strip(ch);
              return d === null ? (
                <span class="sep" aria-hidden="true">{ch}</span>
              ) : (
                <span class="roll" aria-hidden="true">
                  <span class="strip" data-digit={d} style={`--d:${20 + d}`}>
                    {Array.from({ length: 30 }, (_, k) => <span>{k % 10}</span>)}
                  </span>
                </span>
              );
            })}
          </span>
        </div>
      ))}
      <a class="row you" href={brand.events.url} target="_blank" rel="noopener" data-reveal>
        <span class="rank">4th</span>
        <span class="name"><span>You<span class="caret" aria-hidden="true">_</span></span><small>{brand.events.line}</small></span>
        <span class="score play">Play <span class="arrow" aria-hidden="true">↗</span></span>
      </a>
    </section>
  </main>

  <SoftChrome part="foot" />
  <PickerBridge />
</Minimal>

<style>
  .wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 8px var(--pad) 40px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    min-height: min(680px, calc(100svh - 120px));
  }
  .figure { display: grid; gap: 4px; }
  .hint { color: var(--dim); font-size: 13px; text-align: center; }
  .figure :global(.narrow-only), .hint .narrow-only { display: none; }
  @media (max-width: 760px) {
    .figure :global(.wide-only), .hint .wide-only { display: none; }
    .figure :global(.narrow-only) { display: block; max-width: 440px; margin: 0 auto; }
    .hint .narrow-only { display: inline; }
  }
  .label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 400;
  }
  .label .dot { width: 4px; height: 4px; border-radius: 50%; background: var(--accent); }
  .statement {
    margin: 18px 0 32px;
    font-weight: 300;
    font-size: clamp(30px, 3.4vw, 48px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--bright);
    text-wrap: balance;
  }
  .start { height: 44px; padding: 0 22px; font-size: 15px; }

  .board {
    margin-top: clamp(24px, 6vh, 64px);
    border-radius: 28px;
    background: var(--wash);
    box-shadow: inset 0 0 0 1px var(--edge);
    padding: 10px;
  }
  .board-head,
  .row {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 0 18px;
  }
  .board-head {
    height: 44px;
    color: var(--dim);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .right { text-align: right; }
  .row {
    min-height: 84px;
    border-radius: 20px;
    transition: background-color 200ms ease;
  }
  .row + .row { box-shadow: 0 -1px 0 var(--rule); }
  .rank { color: var(--muted); font-size: 15px; font-weight: 400; }
  .name { display: grid; color: var(--bright); font-size: 18px; font-weight: 400; }
  .name small { color: var(--dim); font-size: 13px; font-weight: 300; margin-top: 2px; }
  .score {
    display: inline-flex;
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--bright);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .roll { display: inline-block; height: 1em; overflow: hidden; }
  .strip { display: flex; flex-direction: column; transform: translateY(calc(var(--d) * -1em)); }
  .strip span { height: 1em; text-align: center; }

  .you { box-shadow: 0 -1px 0 var(--rule); }
  .you .name { color: var(--accent); }
  .caret { margin-left: 2px; color: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    .caret { animation: blink 1.1s steps(1) infinite; }
  }
  @keyframes blink { 50% { opacity: 0; } }
  .play { font-size: 18px; font-weight: 400; color: var(--accent); gap: 6px; align-items: baseline; letter-spacing: 0; }
  .play { transition: transform 160ms var(--ease-out); }
  .you:active .play { transform: scale(0.95); }
  @media (hover: hover) and (pointer: fine) {
    .row:hover { background: var(--wash); }
    .you:hover { background: rgba(187, 169, 255, 0.08); }
  }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .figure { order: -1; width: 100%; max-width: 720px; justify-self: center; }
    .board-head, .row { grid-template-columns: 44px minmax(0, 1fr) auto; padding: 0 10px; gap: 10px; }
    .name { font-size: 16px; }
    .name small { display: none; }
  }
</style>

<script>
  import { gsap, onMotionOr, SplitText } from '../../lib/motion';

  onMotionOr(
    () => {
      const split = SplitText.create('.statement', { type: 'words' });
      const tl = gsap.timeline({ defaults: { ease: 'out' } });
      tl.from('.soft-top', { autoAlpha: 0, duration: 0.5 }, 0)
        .from('.label', { autoAlpha: 0, y: 8, duration: 0.5 }, 0.05)
        .from(split.words, { autoAlpha: 0, y: 12, duration: 0.6, stagger: 0.025 }, 0.12)
        .from('.start', { autoAlpha: 0, y: 8, scale: 0.97, duration: 0.45, clearProps: 'transform,translate,rotate,scale' }, 0.5)
        .from('.figure', { autoAlpha: 0, y: 16, duration: 0.9 }, 0.2);

      // The board arrives row by row as it scrolls in; each score then rolls in, right digit first.
      const board = gsap.timeline({ defaults: { ease: 'out' }, scrollTrigger: { trigger: '.board', start: 'top 88%', once: true } });
      board.from('.board', { autoAlpha: 0, y: 16, duration: 0.6 })
        .from('.board-head, .row', { autoAlpha: 0, y: 10, duration: 0.45, stagger: 0.06, clearProps: 'transform,translate,rotate,scale' }, 0.1);
      document.querySelectorAll<HTMLElement>('.score').forEach((score, r) => {
        const strips = [...score.querySelectorAll<HTMLElement>('.strip')].reverse();
        strips.forEach((s, i) => {
          const cell = (s.firstElementChild as HTMLElement).offsetHeight;
          board.fromTo(s, { y: 0 }, { y: -(20 + Number(s.dataset.digit)) * cell, duration: 1.6, ease: 'out' }, 0.25 + r * 0.12 + i * 0.07);
        });
      });

      return () => split.revert();
    },
    () => {
      gsap.from('.row', { opacity: 0, duration: 0.4, stagger: 0.06, ease: 'none' });
    },
  );
</script>
