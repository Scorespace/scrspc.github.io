---
// B1 arcade, dots: each figure drawn in dots, the way the cabinets draw their
// games. Players and games as grids, where a dot stands for a fixed amount; the
// jams as a column of dots for every year, from the jam list itself.
import '../../../styles/soft.css';
import ArcadeHero from '../../../components/ArcadeHero.astro';
import PickerBridge from '../../../components/PickerBridge.astro';
import SoftChrome from '../../../components/SoftChrome.astro';
import Minimal from '../../../layouts/Minimal.astro';
import { brand, studioDescription, title } from '../../../data/brand';
import { jams } from '../../../data/jams';
import { fetchScoreSpaceJams } from '../../../lib/itch-jams';

// Jams per year since we started, from itch.io at build time, or the list in the repo.
const fetched = await fetchScoreSpaceJams();
const source = fetched.length ? fetched : jams;
const perYear = new Map<number, number>();
for (const j of source) {
  const y = new Date(j.date).getUTCFullYear();
  if (y >= brand.jams.since) perYear.set(y, (perYear.get(y) ?? 0) + 1);
}
const last = Math.max(...perYear.keys());
const years = Array.from({ length: last - brand.jams.since + 1 }, (_, k) => brand.jams.since + k).map((y) => ({ y, n: perYear.get(y) ?? 0 }));
const jamCount = years.reduce((a, b) => a + b.n, 0);
const tallest = Math.max(...years.map((y) => y.n));
---

<Minimal
  title={title}
  description={studioDescription}
  noindex
  theme="dark"
  fonts="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;700&display=swap"
>
  <ArcadeHero />

  <main class="wrap">
    <section class="tiles" aria-label="ScoreSpace in numbers">
      <article class="tile" data-reveal>
        <header>
          <p class="label">Players</p>
          <p class="num" data-count={brand.publishing.value} data-suffix={brand.publishing.suffix}>{brand.publishing.stat}</p>
        </header>
        <div class="grid g10" aria-hidden="true">{Array.from({ length: brand.publishing.value * 10 }, () => <i></i>)}</div>
        <p class="note">{brand.publishing.line}, across all platforms. <span>Each dot is 100,000 players.</span></p>
      </article>

      <article class="tile" data-reveal>
        <header>
          <p class="label">Games submitted</p>
          <p class="num" data-count={brand.jams.value} data-suffix={brand.jams.suffix} data-thousands>{brand.jams.stat}</p>
        </header>
        <div class="grid g20" aria-hidden="true">{Array.from({ length: 200 }, () => <i></i>)}</div>
        <p class="note">All time, across every jam. <span>Each dot is 20 games.</span></p>
      </article>

      <article class="tile" data-reveal>
        <header>
          <p class="label">Jamming since</p>
          <p class="num">{brand.jams.since}</p>
        </header>
        <div class="years" aria-label={`${jamCount} jams since ${brand.jams.since}`} style={`--tallest:${tallest};--n:${years.length}`}>
          {years.map(({ y, n }) => (
            <div class="year">
              <div class="stack">{Array.from({ length: n }, () => <i></i>)}</div>
              <span class="yl">{String(y).slice(2)}</span>
            </div>
          ))}
        </div>
        <p class="note">{jamCount} jams and counting. <span>Each dot is a jam.</span></p>
      </article>
    </section>

    <a class="cta" href={brand.events.url} target="_blank" rel="noopener" data-reveal>
      <span class="next" aria-hidden="true"><i></i></span>
      <span class="cta-line">{brand.events.line}</span>
      <span class="cta-host">{brand.events.host} <span class="arrow" aria-hidden="true">↗</span></span>
    </a>
  </main>

  <SoftChrome part="foot" />
  <PickerBridge />
</Minimal>

<style>
  .wrap { padding: clamp(24px, 6vh, 64px) var(--pad) 8px; }
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 24px 26px 26px;
    border-radius: 28px;
    background: var(--wash);
    box-shadow: inset 0 0 0 1px var(--edge);
  }
  .label { color: var(--muted); font-size: 14px; font-weight: 400; }
  .num {
    margin-top: 6px;
    font-weight: 300;
    font-size: clamp(44px, 4.6vw, 72px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--bright);
    font-variant-numeric: tabular-nums;
  }
  .note { margin-top: auto; color: var(--muted); font-size: 14px; }
  .note span { color: var(--dim); }

  /* The dots: the same round marks the cabinets play their games in, one size across every tile,
     each grid as tall as its number needs. */
  .tiles { --d: 10px; --g: 8px; }
  .grid { display: grid; gap: var(--g); justify-content: start; }
  .g10 { grid-template-columns: repeat(10, var(--d)); }
  .g20 { grid-template-columns: repeat(20, var(--d)); }
  .grid i, .stack i {
    display: block;
    width: var(--d);
    height: var(--d);
    border-radius: 50%;
    background: var(--ink);
  }
  .years {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 8px;
    align-items: end;
  }
  .year { display: grid; gap: 8px; justify-items: center; }
  .stack {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--g);
    min-height: calc(var(--tallest) * (var(--d) + var(--g)) - var(--g));
  }
  .yl { color: var(--dim); font-size: 11px; font-variant-numeric: tabular-nums; }

  .cta {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    margin-top: 14px;
    padding: 22px 28px;
    border-radius: 28px;
    background: var(--accent);
    color: var(--accent-ink);
    transition: background-color 200ms ease;
  }
  .next i {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent-ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .next i { animation: beat 1.6s var(--ease-in-out) infinite; }
  }
  @keyframes beat { 50% { opacity: 0.25; } }
  .cta-line { font-weight: 400; font-size: clamp(20px, 2.4vw, 30px); letter-spacing: -0.015em; line-height: 1.15; }
  .cta-host { font-size: 15px; font-weight: 500; white-space: nowrap; }
  @media (hover: hover) and (pointer: fine) {
    .cta:hover { background: #c9baff; }
  }

  @media (max-width: 1180px) {
    .tiles { --g: 6px; --d: 9px; }
  }
  @media (max-width: 960px) {
    .tiles { grid-template-columns: 1fr; --d: 10px; --g: 8px; }
  }
  @media (max-width: 560px) {
    .tiles { --d: 9px; --g: 5px; }
    .tile { padding: 20px; border-radius: 24px; }
    .cta { grid-template-columns: auto 1fr; padding: 20px; }
    .cta-host { grid-column: 2; }
  }
</style>

<script>
  import { formatThousands, gsap, onMotionOr } from '../../../lib/motion';

  onMotionOr(
    () => {
      // Each tile fills in as it scrolls in: players from the middle out, games as they arrive, jams year by year.
      gsap.utils.toArray<HTMLElement>('.tile').forEach((tile, t) => {
        const tl = gsap.timeline({ defaults: { ease: 'out' }, scrollTrigger: { trigger: tile, start: 'top 85%', once: true } });
        tl.from(tile, { autoAlpha: 0, y: 16, duration: 0.6, delay: t * 0.06 });
        const dots = tile.querySelectorAll('.grid i');
        if (dots.length) {
          tl.from(dots, {
            opacity: 0.1,
            scale: 0.5,
            duration: 0.5,
            stagger: { each: t === 0 ? 0.012 : 0.006, from: t === 0 ? 'center' : 'random', grid: t === 0 ? [10, 10] : 'auto' },
          }, 0.2);
        }
        tile.querySelectorAll<HTMLElement>('.stack').forEach((stack, y) => {
          tl.from(stack.children, { opacity: 0.1, scale: 0.5, duration: 0.4, stagger: 0.04 }, 0.2 + y * 0.08);
        });
        const num = tile.querySelector<HTMLElement>('.num[data-count]');
        if (num) {
          const to = Number(num.dataset.count), suffix = num.dataset.suffix ?? '', s = { v: 0 };
          tl.call(() => { num.textContent = '0' + suffix; }, undefined, 0)
            .to(s, { v: to, duration: 1.6, onUpdate: () => { num.textContent = formatThousands(s.v) + suffix; } }, 0.2);
        }
      });
      gsap.from('.cta', {
        autoAlpha: 0,
        y: 14,
        duration: 0.6,
        ease: 'out',
        clearProps: 'transform,translate,rotate,scale',
        scrollTrigger: { trigger: '.cta', start: 'top bottom', once: true },
      });
    },
    () => {
      gsap.from('.tile', { opacity: 0, duration: 0.4, stagger: 0.06, ease: 'none' });
    },
  );
</script>
