---
// B1, format: Story. One pinned stage, four chapters you scroll through, the
// handheld beside them playing faster as the story builds. On small screens
// and for readers who asked for less motion it is simply four sections.
import '../../styles/soft.css';
import HairlineFigure from '../../components/HairlineFigure.astro';
import PickerBridge from '../../components/PickerBridge.astro';
import SoftChrome from '../../components/SoftChrome.astro';
import Minimal from '../../layouts/Minimal.astro';
import { brand, description, title } from '../../data/brand';

const chapters = ['What we do', 'Publishing', 'Jams', 'Events'];
---

<Minimal
  title={title}
  description={description}
  noindex
  theme="dark"
  fonts="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500&display=swap"
>
  <SoftChrome part="top" />

  <main>
    <section class="story">
      <div class="stage">
        <div class="copy">
          <div class="chapters">
            <article class="chapter on">
              <p class="no">01 <span>{chapters[0]}</span></p>
              <h1 class="big">{brand.statementLead} <span class="soft">{brand.statementTail}</span></h1>
            </article>
            <article class="chapter">
              <p class="no">02 <span>{chapters[1]}</span></p>
              <p class="num">{brand.publishing.stat}</p>
              <p class="text">{brand.publishing.label}. {brand.publishing.line}.</p>
            </article>
            <article class="chapter">
              <p class="no">03 <span>{chapters[2]}</span></p>
              <p class="num">{brand.jams.stat}</p>
              <p class="text">{brand.jams.label}. {brand.jams.line}.</p>
            </article>
            <article class="chapter">
              <p class="no">04 <span>{chapters[3]}</span></p>
              <p class="big">{brand.events.line}.</p>
              <a class="pill solid go" href={brand.events.url} target="_blank" rel="noopener">Go to {brand.events.host} <span class="arrow" aria-hidden="true">↗</span></a>
            </article>
          </div>
          <nav class="progress" aria-label="Chapters">
            {chapters.map((c, i) => (
              <button type="button" class:list={['seg', { on: i === 0 }]} data-seg={i} aria-label={`${String(i + 1).padStart(2, '0')} ${c}`}><i></i></button>
            ))}
            <span class="count"><b>01</b> / 04</span>
          </nav>
        </div>
        <div class="figure">
          <HairlineFigure name="handheld" theme="dark" intensity={0.25} label="A handheld console playing falling blocks." />
          <p class="hint">Point at the screen to steer the falling piece.</p>
        </div>
      </div>
    </section>
  </main>

  <SoftChrome part="foot" />
  <PickerBridge />
</Minimal>

<style>
  .stage {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--pad);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 80px);
    align-items: center;
  }
  .no {
    display: flex;
    gap: 12px;
    align-items: baseline;
    color: var(--accent);
    font-size: 14px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }
  .no span { color: var(--muted); }
  .big {
    margin: 20px 0 0;
    font-weight: 300;
    font-size: clamp(30px, 3.6vw, 54px);
    line-height: 1.16;
    letter-spacing: -0.025em;
    color: var(--bright);
    text-wrap: balance;
  }
  .soft { color: var(--muted); }
  .num {
    margin-top: 18px;
    font-weight: 300;
    font-size: clamp(88px, 12vw, 176px);
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--bright);
    font-variant-numeric: tabular-nums;
  }
  .text { margin-top: 18px; max-width: 30ch; color: var(--muted); font-size: 18px; }
  .go { margin-top: 32px; height: 46px; padding: 0 22px; font-size: 15px; }
  .hint { color: var(--dim); font-size: 13px; text-align: center; }
  .figure :global(.hl) { max-width: 560px; margin: 0 auto; }

  /* Stacked, the default: four sections in a column. */
  .chapter { padding: 48px 0; }
  .progress { display: none; }

  /* Pinned, where there is room and motion is welcome: one stage, chapters taking turns. */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    :global(.js) .stage { height: 100svh; }
    :global(.js) .chapters { position: relative; height: min(440px, 56svh); }
    :global(.js) .chapter { position: absolute; inset: 0; padding: 0; display: flex; flex-direction: column; justify-content: center; visibility: hidden; }
    :global(.js) .chapter.on { visibility: visible; }
    :global(.js) .progress { display: flex; align-items: center; gap: 8px; margin-top: 32px; }
  }
  .seg {
    width: 44px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    align-items: center;
    transition: transform 160ms var(--ease-out);
  }
  .seg:active { transform: scale(0.94); }
  .seg i {
    display: block;
    height: 3px;
    border-radius: 3px;
    background: var(--wash-2);
    position: relative;
    overflow: hidden;
  }
  .seg i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 300ms var(--ease-out);
  }
  .seg.on i::after { transform: scaleX(1); }
  .count { margin-left: 10px; color: var(--dim); font-size: 13px; font-variant-numeric: tabular-nums; }
  .count b { color: var(--ink); font-weight: 400; }

  @media (max-width: 899px) {
    .stage { grid-template-columns: 1fr; }
    .figure { order: -1; }
    .figure :global(.hl) { max-width: 360px; }
    .chapter { padding: 36px 0; border-top: 1px solid var(--rule); }
  }
</style>

<script>
  import { gsap, onMotionOr, ScrollTrigger } from '../../lib/motion';

  const chapters = [...document.querySelectorAll<HTMLElement>('.chapter')];
  const segs = [...document.querySelectorAll<HTMLButtonElement>('.seg')];
  const count = document.querySelector<HTMLElement>('.count b')!;
  const host = document.querySelector<HTMLElement & { hairline?: { set: (i: number) => void } }>('[data-hl-figure]');

  const mm = gsap.matchMedia();
  mm.add('(min-width: 900px) and (prefers-reduced-motion: no-preference)', () => {
    let current = 0;
    gsap.from(['.soft-top', '.copy', '.figure'], { autoAlpha: 0, y: 12, duration: 0.7, ease: 'out', stagger: 0.08 });

    // Exit fast, enter slower: the old chapter blurs away in 220ms, the new one settles in over 500ms.
    function show(next: number) {
      if (next === current) return;
      const out = chapters[current], into = chapters[next], dir = next > current ? 1 : -1;
      gsap.killTweensOf([out, into, ...into.children]);
      gsap.to(out, { autoAlpha: 0, y: -10 * dir, filter: 'blur(4px)', duration: 0.22, ease: 'inOut', onComplete: () => { out.classList.remove('on'); } });
      into.classList.add('on');
      gsap.fromTo(into, { autoAlpha: 0, y: 14 * dir, filter: 'blur(6px)' }, { autoAlpha: 1, y: 0, filter: 'blur(0px)', duration: 0.5, ease: 'out', delay: 0.08 });
      gsap.from(into.children, { y: 10 * dir, duration: 0.5, ease: 'out', stagger: 0.05, delay: 0.08, clearProps: 'transform,translate,rotate,scale' });
      segs.forEach((s, i) => s.classList.toggle('on', i <= next));
      count.textContent = String(next + 1).padStart(2, '0');
      host?.hairline?.set(0.25 + next * 0.25); // the game picks up pace as the story builds
      current = next;
    }

    const st = ScrollTrigger.create({
      trigger: '.story',
      start: 'top top',
      end: '+=300%',
      pin: '.stage',
      snap: { snapTo: [0, 1 / 3, 2 / 3, 1], duration: { min: 0.2, max: 0.5 }, ease: 'inOut', delay: 0.08 },
      onUpdate: (self) => show(Math.round(self.progress * 3)),
    });
    segs.forEach((s, i) => s.addEventListener('click', () => {
      window.scrollTo({ top: st.start + (st.end - st.start) * (i / 3), behavior: 'smooth' });
    }));

    return () => {
      chapters.forEach((c, i) => { c.classList.toggle('on', i === 0); gsap.set(c, { clearProps: 'all' }); });
    };
  });

  onMotionOr(
    () => {
      // Stacked on small screens: each chapter rises in as it arrives.
      if (matchMedia('(min-width: 900px)').matches) return;
      chapters.forEach((c) => gsap.from(c, { autoAlpha: 0, y: 16, duration: 0.6, ease: 'out', scrollTrigger: { trigger: c, start: 'top 90%', once: true } }));
    },
    () => {},
  );
</script>
