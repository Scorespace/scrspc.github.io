---
// Variation B2: Index, navy. Deep blue ground, Lato, cyan as the one accent, the arcade cabinets.
import HairlineFigure from '../components/HairlineFigure.astro';
import Minimal from '../layouts/Minimal.astro';
import { brand, description, indexRows, title } from '../data/brand';

const BASE = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<Minimal
  title={title}
  description={description}
  noindex
  theme="dark"
  fonts="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap"
>
  <div class="frame">
    <header class="top" data-reveal>
      <a class="logo" href={BASE} aria-label={brand.name}>
        <img src={`${BASE}${brand.logo}`} alt={brand.name} width="800" height="463" />
      </a>
      <span class="meta">Est. {brand.jams.since}</span>
      <span class="meta wide">Game jams → published games</span>
      <a class="meta link" href={brand.events.url} target="_blank" rel="noopener">Events on Jamzo <span class="arrow" aria-hidden="true">↗</span></a>
    </header>

    <main class="mid">
      <h1 class="statement" data-reveal>{brand.statement}</h1>
      <div class="figure" data-reveal>
        <HairlineFigure name="cabinets" theme="dark" label="A row of arcade cabinets; the one under the pointer rolls forward." />
      </div>
    </main>

    <ol class="index">
      {indexRows.map((r) => (
        <li class="row" data-reveal>
          <span class="row-rule"></span>
          <span class="no">{r.no}</span>
          <span class="key">{r.key}</span>
          <span class="val">{r.val}</span>
          <span class="aux">
            {r.num && <b data-count={r.num}>{r.num}</b>}
            <span class="aux-label">{r.aux}</span>
          </span>
        </li>
      ))}
      <li class="row" data-reveal>
        <span class="row-rule"></span>
        <a class="row-link" href={brand.events.url} target="_blank" rel="noopener">
          <span class="no">04</span>
          <span class="key">Events</span>
          <span class="val">{brand.events.line}</span>
          <span class="aux accent">{brand.events.host} <span class="arrow" aria-hidden="true">↗</span></span>
        </a>
      </li>
    </ol>

    <footer class="foot" data-reveal>
      <span class="row-rule"></span>
      <span>© {year} {brand.name}</span>
      <nav aria-label="Social">
        {brand.social.map((s) => <a href={s.url} target="_blank" rel="noopener">{s.label}</a>)}
      </nav>
      <nav aria-label="Legal">
        {brand.legal.map((l) => <a href={`${BASE}${l.path}`}>{l.label}</a>)}
      </nav>
    </footer>
  </div>
</Minimal>

<style is:global>
  :root {
    color-scheme: dark;
    --ground: #030a1c;
    --ink: #d3def5;
    --bright: #ffffff;
    --muted: #7d90b8;
    --dim: #4b5d85;
    --rule: #12204a;
    --accent: #06befc;
    --pad: clamp(16px, 2.6vw, 36px);
    --hairline-plate: var(--ground);
    --hairline-hi: var(--accent);
    --hairline-edge: #6a80b2;
    --hairline-mid: #2a3a68;
    --hairline-lo: #182649;
    --hl-read: var(--muted);
  }
  * { box-sizing: border-box; }
  html { background: var(--ground); }
  body {
    margin: 0;
    color: var(--ink);
    font: 400 15px/1.5 'Lato', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  ::selection { background: var(--accent); color: var(--ground); }
</style>

<style>
  .frame {
    min-height: 100svh;
    padding: 0 var(--pad);
    display: grid;
    grid-template-rows: auto 1fr auto auto;
  }
  .top,
  .mid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 16px;
  }
  .top {
    align-items: center;
    height: 72px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .logo { grid-column: span 3; }
  .logo img { display: block; height: 26px; width: auto; }
  .meta { grid-column: span 2; white-space: nowrap; }
  .meta.wide { grid-column: span 4; }
  .meta.link { grid-column: span 3; justify-self: end; color: var(--ink); transition: color 0.3s; }
  .meta.link:hover { color: var(--accent); }
  .arrow {
    display: inline-block;
    transition: transform 0.5s cubic-bezier(0.32, 0.72, 0, 1);
  }
  a:hover .arrow { transform: translate(2px, -2px); }

  .mid {
    align-items: center;
    padding: clamp(24px, 6vh, 72px) 0;
  }
  .statement {
    grid-column: 1 / span 6;
    margin: 0;
    font-weight: 300;
    font-size: clamp(32px, 3.6vw, 56px);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--bright);
    text-wrap: balance;
  }
  .figure { grid-column: 7 / span 6; }

  .index {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row,
  .row-link {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 16px;
    align-items: baseline;
  }
  .row { padding: 16px 0 17px; transition: color 0.4s; }
  .row:has(.row-link) { display: block; }
  .row-link { grid-column: 1 / -1; }
  .row-rule {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--rule);
    transform-origin: left center;
  }
  .row::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.7s cubic-bezier(0.32, 0.72, 0, 1);
    z-index: 1;
  }
  .row:hover::after { transform: scaleX(1); }
  .row:hover { color: var(--bright); }
  .no { grid-column: span 1; color: var(--dim); font-weight: 700; font-size: 11px; letter-spacing: 0.14em; }
  .key { grid-column: span 2; color: var(--muted); font-weight: 700; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; }
  .val { grid-column: span 5; }
  .aux { grid-column: span 4; justify-self: end; text-align: right; color: var(--muted); }
  .aux b {
    margin-right: 10px;
    font-weight: 300;
    font-size: 26px;
    letter-spacing: -0.01em;
    color: var(--bright);
    font-variant-numeric: tabular-nums;
  }
  .aux.accent { color: var(--accent); }

  .foot {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    padding: 18px 0 24px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .foot nav { display: flex; gap: 20px; }
  .foot nav:last-child { margin-left: auto; }
  .foot a { transition: color 0.3s; }
  .foot a:hover { color: var(--ink); }

  @media (max-width: 900px) {
    .meta.wide { display: none; }
    .logo { grid-column: span 6; }
    .meta { grid-column: span 3; }
    .meta.link { grid-column: span 3; }
    .statement { grid-column: 1 / -1; }
    .figure { grid-column: 2 / span 10; margin-top: 16px; }
    .no { grid-column: span 2; }
    .key { grid-column: span 4; }
    .val { grid-column: 7 / -1; }
    .aux { grid-column: 7 / -1; justify-self: start; text-align: left; margin-top: 4px; }
  }
  @media (max-width: 560px) {
    .meta:not(.link) { display: none; }
    .logo { grid-column: span 6; }
    .meta.link { grid-column: span 6; }
    .figure { grid-column: 1 / -1; }
    .val, .aux { grid-column: 1 / -1; }
    .val { margin-top: 6px; }
    .aux b { font-size: 22px; }
    .foot nav:last-child { margin-left: 0; }
  }
</style>

<script>
  import { gsap, onMotion, SplitText } from '../lib/motion';

  onMotion(() => {
    const split = SplitText.create('.statement', { type: 'lines', mask: 'lines' });
    const tl = gsap.timeline({ defaults: { ease: 'hairline' } });

    tl.from('.top', { autoAlpha: 0, y: -8, duration: 0.9 }, 0)
      // The masks clip descenders, so the split goes once the lines land.
      .from(split.lines, { yPercent: 105, duration: 1.2, stagger: 0.09, onComplete: () => split.revert() }, 0.15)
      .from('.figure', { autoAlpha: 0, y: 24, duration: 1.4 }, 0.45)
      .from('.row-rule', { scaleX: 0, duration: 1.3, stagger: 0.08 }, 0.7)
      .from('.row > :not(.row-rule)', { autoAlpha: 0, y: 8, duration: 0.9, stagger: 0.02 }, 0.8)
      .from('.foot > :not(.row-rule)', { autoAlpha: 0, duration: 0.8 }, 1.2);

    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el, i) => {
      const text = el.dataset.count!;
      const to = Number(text.replace(/[^0-9]/g, ''));
      const suffix = text.replace(/[0-9,]/g, '');
      const state = { v: 0 };
      el.textContent = '0' + suffix;
      tl.to(state, {
        v: to,
        duration: 1.6,
        ease: 'power3.out',
        onUpdate: () => { el.textContent = Math.round(state.v).toLocaleString('en-US') + suffix; },
      }, 0.9 + i * 0.12);
    });

    return () => split.revert();
  });
</script>
