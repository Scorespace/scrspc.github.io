---
// Variation C: Single screen. White ground, the figure as the hero, one sentence, one button.
import HairlineFigure from '../components/HairlineFigure.astro';
import Minimal from '../layouts/Minimal.astro';
import { brand, description, title } from '../data/brand';

const BASE = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<Minimal
  title={title}
  description={description}
  noindex
  fonts="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500&display=swap"
>
  <div class="screen">
    <header class="top" data-reveal>
      <a class="logo" href={BASE} aria-label={brand.name}>
        <img src={`${BASE}${brand.logo}`} alt={brand.name} width="800" height="463" />
      </a>
    </header>

    <main class="center">
      <div class="figure" data-reveal>
        <HairlineFigure name="arcade" label="An arcade stick whose lever leans toward the pointer." />
      </div>

      <h1 class="statement" data-reveal>
        {brand.statementLead} <em>{brand.statementTail}</em>
      </h1>

      <dl class="stats" data-reveal>
        <div>
          <dt>{brand.publishing.stat}</dt>
          <dd>{brand.publishing.label}</dd>
          <dd class="sub">{brand.publishing.line}</dd>
        </div>
        <div>
          <dt>{brand.jams.stat}</dt>
          <dd>{brand.jams.label}</dd>
          <dd class="sub">Running game jams since {brand.jams.since}</dd>
        </div>
      </dl>

      <a class="cta" href={brand.events.url} target="_blank" rel="noopener" data-reveal>
        <span class="cta-label">{brand.events.short}</span>
        <span class="cta-arrow" aria-hidden="true">→</span>
      </a>
    </main>

    <footer class="foot" data-reveal>
      <span>© {year} {brand.name}</span>
      {brand.social.map((s) => <a href={s.url} target="_blank" rel="noopener">{s.label}</a>)}
      {brand.legal.map((l) => <a href={`${BASE}${l.path}`}>{l.label}</a>)}
    </footer>
  </div>
</Minimal>

<style is:global>
  :root {
    color-scheme: light;
    --ground: #ffffff;
    --ink: #18181b;
    --muted: #8a8a93;
    --line: #e4e4e7;
    --hairline-plate: var(--ground);
    --hl-read: var(--muted);
  }
  * { box-sizing: border-box; }
  html { background: var(--ground); }
  body {
    margin: 0;
    color: var(--ink);
    font: 400 13px/1.5 'Inter', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
</style>

<style>
  .screen {
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    padding: 0 20px;
  }

  .top { padding-top: 28px; }
  .logo img { display: block; height: 26px; width: auto; }

  .center {
    width: 100%;
    max-width: 600px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px 0 40px;
  }
  /* The 5:4 stage has air above and below the drawing; pull the page in around it. */
  .figure {
    width: min(440px, 100%);
    margin: -9% 0 28px;
  }
  .figure :global(.hl-read) {
    position: static;
    display: block;
    margin-top: -8%;
    text-align: center;
  }

  .statement {
    margin: 0;
    font-family: 'Instrument Serif', Georgia, serif;
    font-weight: 400;
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .statement em { color: var(--muted); }

  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin: 36px 0 0;
    width: 100%;
    max-width: 520px;
  }
  .stats div {
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .stats dt {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: 40px;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .stats dd {
    margin: 8px 0 0;
    color: var(--ink);
  }
  .stats dd.sub {
    margin-top: 2px;
    color: var(--muted);
  }

  .cta {
    margin-top: 40px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 20px 0 22px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    transition: background-color 0.4s cubic-bezier(0.32, 0.72, 0, 1), color 0.4s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .cta:hover {
    background: var(--ink);
    color: var(--ground);
  }
  .cta-arrow {
    display: inline-block;
    transition: transform 0.5s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .cta:hover .cta-arrow { transform: translateX(3px); }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 20px;
    padding: 0 0 24px;
    font-size: 12px;
    color: var(--muted);
  }
  .foot a { transition: color 0.3s; }
  .foot a:hover { color: var(--ink); }

  @media (max-width: 480px) {
    .stats { gap: 20px; }
    .stats dt { font-size: 34px; }
  }
</style>

<script>
  import { gsap, magnet, onMotion, SplitText } from '../lib/motion';

  onMotion(() => {
    const split = SplitText.create('.statement', { type: 'words', mask: 'words' });
    const tl = gsap.timeline({ defaults: { ease: 'hairline' } });

    tl.from('.top', { autoAlpha: 0, y: -6, duration: 0.8 }, 0)
      .from('.figure', { autoAlpha: 0, y: 20, scale: 0.97, duration: 1.4 }, 0.05)
      .from(split.words, { yPercent: 100, duration: 1, stagger: 0.03, onComplete: () => split.revert() }, 0.35)
      .from('.stats > div', { autoAlpha: 0, y: 12, duration: 0.9, stagger: 0.1 }, 0.8)
      .from('.cta', { autoAlpha: 0, y: 10, duration: 0.9 }, 1)
      .from('.foot', { autoAlpha: 0, duration: 0.8 }, 1.1);

    const release = magnet(document.querySelector<HTMLElement>('.cta')!, 6);
    return () => {
      release();
      split.revert();
    };
  });
</script>
