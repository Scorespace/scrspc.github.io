---
// Variation B: Index. Dark ground, a ruled twelve-column grid, everything in mono but the statement.
import HairlineFigure from '../components/HairlineFigure.astro';
import Minimal from '../layouts/Minimal.astro';
import { brand, description, indexRows, title } from '../data/brand';

const BASE = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<Minimal
  title={title}
  description={description}
  noindex
  theme="dark"
  fonts="https://fonts.googleapis.com/css2?family=Geist:wght@300;400&family=Geist+Mono:wght@400&display=swap"
>
  <div class="frame">
    <div class="cols" aria-hidden="true" data-reveal>
      {Array.from({ length: 13 }, () => <span class="col"></span>)}
    </div>

    <header class="top" data-reveal>
      <a class="logo" href={BASE} aria-label={brand.name}>
        <img src={`${BASE}${brand.logo}`} alt={brand.name} width="800" height="463" />
      </a>
      <span class="meta" data-scramble>Est. {brand.jams.since}</span>
      <span class="meta wide" data-scramble>Game jams → published games</span>
      <a class="meta link" href={brand.events.url} target="_blank" rel="noopener"><span data-scramble>Events on Jamzo</span> <span class="arrow" aria-hidden="true">↗</span></a>
    </header>

    <main class="mid">
      <h1 class="statement" data-reveal>{brand.statement}</h1>
      <div class="figure" data-reveal>
        <HairlineFigure name="tokens" theme="dark" label="Stacks of arcade tokens that pile up around the pointer." />
      </div>
    </main>

    <ol class="index">
      {indexRows.map((r) => (
        <li class="row" data-reveal>
          <span class="row-rule"></span>
          <span class="no">{r.no}</span>
          <span class="key">{r.key}</span>
          <span class="val">{r.val}</span>
          <span class="aux">
            {r.num && <b data-num={r.num}>{r.num}</b>} {r.aux}
          </span>
        </li>
      ))}
      <li class="row" data-reveal>
        <span class="row-rule"></span>
        <a class="row-link" href={brand.events.url} target="_blank" rel="noopener">
          <span class="no">04</span>
          <span class="key">Events</span>
          <span class="val">{brand.events.line}</span>
          <span class="aux accent">{brand.events.host} <span class="arrow" aria-hidden="true">↗</span></span>
        </a>
      </li>
    </ol>

    <footer class="foot" data-reveal>
      <span class="row-rule"></span>
      <span>© {year} {brand.name}</span>
      <nav aria-label="Social">
        {brand.social.map((s) => <a href={s.url} target="_blank" rel="noopener">{s.label}</a>)}
      </nav>
      <nav aria-label="Legal">
        {brand.legal.map((l) => <a href={`${BASE}${l.path}`}>{l.label}</a>)}
      </nav>
    </footer>
  </div>
</Minimal>

<style is:global>
  :root {
    color-scheme: dark;
    --ground: #08090a;
    --ink: #d0d6e0;
    --bright: #f4f6f8;
    --muted: #8a8c95;
    --dim: #5b5d64;
    --line: #1d1e21;
    --rule: #29292d;
    --accent: #06befc;
    --pad: clamp(16px, 2.4vw, 32px);
    --hairline-plate: var(--ground);
    --hl-read: var(--muted);
  }
  * { box-sizing: border-box; }
  html { background: var(--ground); }
  body {
    margin: 0;
    color: var(--ink);
    font: 400 12.5px/1.5 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.01em;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  ::selection { background: var(--accent); color: var(--ground); }
</style>

<style>
  .frame {
    position: relative;
    min-height: 100svh;
    padding: 0 var(--pad);
    display: grid;
    grid-template-rows: auto 1fr auto auto;
  }
  .cols {
    position: absolute;
    inset: 0 var(--pad);
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }
  .col {
    width: 1px;
    background: var(--line);
    transform-origin: top center;
  }

  .top,
  .mid,
  .index,
  .foot {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
  }

  .top {
    align-items: center;
    height: 64px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .top > * { padding-left: 10px; }
  .top > :first-child { padding-left: 0; }
  .logo { grid-column: span 3; }
  .logo img { display: block; height: 24px; width: auto; }
  .meta { grid-column: span 2; white-space: nowrap; }
  .meta.wide { grid-column: span 4; }
  .meta.link {
    grid-column: span 3;
    justify-self: end;
    color: var(--ink);
    transition: color 0.3s;
  }
  .meta.link:hover { color: var(--accent); }

  .arrow {
    display: inline-block;
    transition: transform 0.5s cubic-bezier(0.32, 0.72, 0, 1);
  }
  a:hover .arrow { transform: translate(2px, -2px); }

  .mid {
    align-items: center;
    padding: clamp(24px, 6vh, 72px) 0;
  }
  .statement {
    grid-column: 1 / span 6;
    margin: 0;
    font-family: 'Geist', system-ui, sans-serif;
    font-weight: 300;
    font-size: clamp(28px, 3.2vw, 48px);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--bright);
    text-wrap: balance;
  }
  .figure {
    grid-column: 8 / span 5;
  }

  .index {
    list-style: none;
    margin: 0;
    padding: 0;
    display: block;
  }
  .row,
  .row-link {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: baseline;
  }
  .row { padding: 14px 0 15px; }
  .row-link { grid-column: 1 / -1; }
  .row:has(.row-link) { display: block; }
  .row-rule {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--rule);
    transform-origin: left center;
  }
  .row::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.7s cubic-bezier(0.32, 0.72, 0, 1);
    z-index: 1;
  }
  .row:hover::after { transform: scaleX(1); }
  .row:hover { color: var(--bright); }
  .no { grid-column: span 1; color: var(--dim); }
  .key { grid-column: span 2; text-transform: uppercase; color: var(--muted); }
  .val { grid-column: span 5; }
  .aux { grid-column: span 4; justify-self: end; text-align: right; color: var(--muted); }
  .aux b { font-weight: 400; color: var(--bright); font-variant-numeric: tabular-nums; }
  .aux.accent { color: var(--accent); }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    padding: 16px 0 22px;
    color: var(--dim);
    text-transform: uppercase;
  }
  .foot nav { display: flex; gap: 18px; }
  .foot nav:last-child { margin-left: auto; }
  .foot a { transition: color 0.3s; }
  .foot a:hover { color: var(--ink); }

  @media (max-width: 900px) {
    .meta.wide { display: none; }
    .logo { grid-column: span 6; }
    .meta { grid-column: span 3; }
    .meta.link { grid-column: span 3; }
    .statement { grid-column: 1 / -1; }
    .figure { grid-column: 2 / span 10; margin-top: 24px; }
    .no { grid-column: span 2; }
    .key { grid-column: span 4; }
    .val { grid-column: 7 / -1; }
    .aux { grid-column: 7 / -1; justify-self: start; text-align: left; margin-top: 4px; }
  }
  @media (max-width: 560px) {
    .col:nth-child(even) { display: none; }
    .meta:not(.link) { display: none; }
    .logo { grid-column: span 6; }
    .meta.link { grid-column: span 6; }
    .figure { grid-column: 1 / -1; }
    .val { grid-column: 1 / -1; margin-top: 6px; }
    .aux { grid-column: 1 / -1; }
    .foot nav:last-child { margin-left: 0; }
  }
</style>

<script>
  import { gsap, onMotion, SplitText } from '../lib/motion';

  onMotion(() => {
    const tl = gsap.timeline({ defaults: { ease: 'hairline' } });
    const split = SplitText.create('.statement', { type: 'words' });

    tl.from('.col', { scaleY: 0, duration: 1.6, stagger: { each: 0.035, from: 'start' } }, 0)
      .from('.top', { autoAlpha: 0, duration: 0.6 }, 0.1)
      .to(
        '[data-scramble]',
        {
          duration: 1,
          stagger: 0.12,
          ease: 'none',
          scrambleText: { text: '{original}', chars: 'upperCase', revealDelay: 0.2, speed: 0.5 },
        },
        0.2,
      )
      .from(split.words, { autoAlpha: 0, y: 10, duration: 0.9, stagger: 0.025 }, 0.35)
      .from('.figure', { autoAlpha: 0, y: 16, duration: 1.2 }, 0.6)
      .from('.row-rule', { scaleX: 0, duration: 1.2, stagger: 0.08 }, 0.7)
      .from('.row > :not(.row-rule)', { autoAlpha: 0, x: -6, duration: 0.8, stagger: 0.02 }, 0.8)
      .from('.foot > :not(.row-rule)', { autoAlpha: 0, duration: 0.8 }, 1.2);

    document.querySelectorAll<HTMLElement>('[data-num]').forEach((el, i) => {
      tl.set(el, { textContent: '' }, 0).to(
        el,
        { duration: 1.4, ease: 'none', scrambleText: { text: el.dataset.num!, chars: '0123456789', speed: 0.6 } },
        0.95 + i * 0.12,
      );
    });

    return () => split.revert();
  });
</script>
