---
// The top of the homepage: the logo, the way to events, and the studio tagline, with three arcade
// cabinets beside it taking turns to play breakout, tetris and snake. On narrow
// screens one cabinet plays all three.
import HairlineFigure from './HairlineFigure.astro';
import { brand } from '../data/brand';

const BASE = import.meta.env.BASE_URL;
---

<header class="top" data-reveal>
  <a class="logo" href={BASE} aria-label={brand.name}>
    <img src={`${BASE}${brand.logo}`} alt={brand.name} width="800" height="463" />
  </a>
  <a class="pill" href={brand.events.url} target="_blank" rel="noopener">Events on Jamzo <span class="arrow" aria-hidden="true">↗</span></a>
</header>

<section class="hero">
  <h1 class="statement" data-reveal>{brand.tagline}</h1>
  <div class="figure" data-reveal>
    <HairlineFigure
      name="arcade-trio"
      class="wide-only"
      theme="dark"
      play={false}
      readout={false}
      label="Three arcade cabinets taking turns to play breakout, tetris and snake."
    />
    <HairlineFigure
      name="arcade-solo"
      class="narrow-only"
      theme="dark"
      play={false}
      readout={false}
      label="An arcade cabinet that changes game every few seconds: breakout, tetris, snake."
    />
  </div>
</section>

<style>
  /* Just the logo and the way to events, at either end. */
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 80px;
    padding: 0 var(--pad);
  }
  .logo img { display: block; height: 40px; width: auto; }

  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 16px;
    padding: 0 var(--pad);
  }

  .hero {
    align-items: center;
    min-height: min(720px, calc(100svh - 80px));
    padding-top: clamp(16px, 4vh, 48px);
    padding-bottom: clamp(16px, 4vh, 48px);
  }
  .statement {
    grid-column: 1 / span 6;
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: calc(clamp(36px, 4.4vw, 68px) * var(--display-scale));
    line-height: 1.08;
    letter-spacing: var(--display-tracking);
    color: var(--bright);
    text-wrap: balance;
  }
  .statement .soft { color: var(--muted); }
  .figure { grid-column: 7 / span 6; display: grid; gap: 4px; }
  .figure :global(.narrow-only) { display: none; }
  /* Each game in its own brand colour: its bright dots, its lit screen, its sparks and marquee lights. */
  .figure :global(g[data-game='breakout']) { --hl-hi: var(--brand-cyan); }
  .figure :global(g[data-game='tetris']) { --hl-hi: #8f4dff; }
  .figure :global(g[data-game='snake']) { --hl-hi: #3f7dff; }

  /* On a phone the header stays: slimmer, on the page's ground, a hairline under it once the page has scrolled. */
  @media (max-width: 899px) {
    .top {
      position: sticky;
      top: 0;
      z-index: 30;
      height: 64px;
      background: var(--ground);
      box-shadow: 0 1px 0 transparent;
      transition: box-shadow 200ms ease;
    }
    :global(html.scrolled) .top { box-shadow: 0 1px 0 var(--rule); }
  }

  @media (max-width: 900px) {
    .hero { min-height: 0; row-gap: 24px; }
    .statement { grid-column: 1 / -1; text-align: center; }
    .figure { grid-column: 1 / -1; order: -1; max-width: 680px; width: 100%; justify-self: center; }
  }
  @media (max-width: 760px) {
    .figure :global(.wide-only) { display: none; }
    .figure :global(.narrow-only) { display: block; max-width: 420px; margin: 0 auto; }
  }
</style>

<script>
  import { gsap, onMotion, SplitText } from '../lib/motion';

  // The sticky header's hairline: on once the page has scrolled at all.
  const mark = () => document.documentElement.classList.toggle('scrolled', scrollY > 4);
  addEventListener('scroll', mark, { passive: true });
  mark();

  // Screen shake: each game's moments jolt its own cabinet, subtly: about 1.5 units of the figure, a couple of pixels.
  const amp = 1.5;
  const shakes: Record<string, (g: SVGGElement, a: number) => gsap.core.Timeline> = {
    // Breakout: a quick sideways jolt as a brick breaks.
    jolt: (g, a) => gsap.timeline().to(g, { x: a, duration: 0.05, ease: 'none' }).to(g, { x: -a * 0.7, duration: 0.05, ease: 'none' }).to(g, { x: 0, duration: 0.1, ease: 'out' }),
    // Tetris: a line clears with a downward thud and a bounce back; a piece landing is a small nudge.
    thud: (g, a) => gsap.timeline().to(g, { y: a, duration: 0.06, ease: 'none' }).to(g, { y: 0, duration: 0.45, ease: 'back.out(3)' }),
    land: (g, a) => gsap.timeline().to(g, { y: a * 0.3, duration: 0.05, ease: 'none' }).to(g, { y: 0, duration: 0.16, ease: 'out' }),
    // Snake: eating is a little hop; crashing is a rattle that settles.
    hop: (g, a) => gsap.timeline().to(g, { y: -a, duration: 0.1, ease: 'out' }).to(g, { y: 0, duration: 0.35, ease: 'bounce.out' }),
    crash: (g, a) => {
      const tl = gsap.timeline();
      for (let i = 0; i < 6; i++) tl.to(g, { x: gsap.utils.random(-2 * a, 2 * a), y: gsap.utils.random(-2 * a, 2 * a), duration: 0.045, ease: 'none' });
      return tl.to(g, { x: 0, y: 0, duration: 0.08, ease: 'out' });
    },
  };
  onMotion(() => {
    const shake = (e: Event) => {
      const { game, fx } = (e as CustomEvent<{ game: string; fx: string }>).detail;
      const g = (e.target as Element).querySelector<SVGGElement>(`svg g[data-game="${game}"]`);
      if (!g || !shakes[fx]) return;
      gsap.killTweensOf(g);
      shakes[fx](g, amp);
    };
    document.addEventListener('arcade', shake);
    return () => document.removeEventListener('arcade', shake);
  });

  onMotion(() => {
    const split = SplitText.create('.hero .statement', { type: 'words' });
    const tl = gsap.timeline({ defaults: { ease: 'out' } });
    tl.from('.top', { autoAlpha: 0, duration: 0.6 }, 0)
      .from(split.words, { autoAlpha: 0, y: 14, filter: 'blur(6px)', duration: 0.9, stagger: 0.03 }, 0.1)
      .from('.hero .figure', { autoAlpha: 0, y: 16, duration: 1.1 }, 0.25);
    return () => split.revert();
  });
</script>
