---
// One Hairline figure (public/hairline/<name>.js), mounted by public/hairline/mount.js.
// The plate takes the page's ground through --hairline-plate, set by the page.
interface Props {
  name: 'cartridges' | 'tokens' | 'arcade' | 'cabinets' | 'controller' | 'crt' | 'crt-snake' | 'cabinets-play' | 'handheld' | 'phone' | 'arcade-row' | 'arcade-solo' | 'arcade-trio' | 'concepts';
  label: string;
  theme?: 'light' | 'dark';
  intensity?: number;
  play?: boolean;
  readout?: boolean;
  class?: string;
}

const { name, label, theme = 'light', intensity = 0.5, play = true, readout = true, class: className } = Astro.props;
const BASE = import.meta.env.BASE_URL;
---

<figure
  class:list={['hl', className]}
  data-hl-figure={name}
  data-label={label}
  data-intensity={intensity}
  data-play={play ? '' : undefined}
>
  <div class="hl-stage" data-hl-stage data-hairline-theme={theme}></div>
  {readout && <figcaption class="hl-read" data-hl-read aria-hidden="true">rest</figcaption>}
</figure>

<script is:inline defer src={`${BASE}hairline/kernel.js`}></script>
<script is:inline defer src={`${BASE}hairline/mount.js`}></script>
<script is:inline type="module" src={`${BASE}hairline/${name}.js`}></script>

<style>
  .hl {
    position: relative;
    margin: 0;
    width: 100%;
  }
  .hl-stage {
    width: 100%;
  }
  .hl-read {
    position: absolute;
    top: 0;
    right: 0;
    font: 11px/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--hl-read, currentColor);
    opacity: 0.7;
    pointer-events: none;
  }
</style>
