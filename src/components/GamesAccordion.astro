---
// Featured games, as an accordion: one row per showcased game, its name and platform up front,
// opening to a line about it and a way to play. Built on <details>, so it works
// without JS and from the keyboard; only one row is open at a time.
import { games } from '../data/games';

const list = games.filter((g) => g.showcase);
const platform: Record<string, string> = { discord: 'Discord', itch: 'itch.io', steam: 'Steam', web: 'the web', reddit: 'Reddit' };
const where: Record<string, string> = { discord: 'Discord', itch: 'itch.io', steam: 'Steam', web: 'Web', reddit: 'Reddit' };
---

<section class="games" aria-labelledby="games-title">
  <header class="head" data-reveal>
    <p class="kicker" id="games-title">Featured Games</p>
    <p class="count">{String(list.length).padStart(2, '0')}</p>
  </header>
  <div class="list">
    {list.map((g, i) => (
      <details class="game" name="games" data-reveal>
        <summary>
          <span class="no">{String(i + 1).padStart(2, '0')}</span>
          <span class="name">{g.name}</span>
          <span class="platform">{where[g.platform]}</span>
          <span class="chev" aria-hidden="true"></span>
        </summary>
        <div class="body">
          <p class="desc">{g.description}</p>
          <a class="pill solid play" href={g.url} target="_blank" rel="noopener">
            Play on {platform[g.platform]} <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .games { padding: clamp(48px, 10vh, 112px) var(--pad) 0; }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 14px;
  }
  .kicker { color: var(--muted); font-size: 14px; font-weight: 400; }
  .count { color: var(--dim); font-size: 14px; font-variant-numeric: tabular-nums; }

  .list { display: grid; gap: 10px; }
  .game {
    border-radius: 24px;
    background: var(--wash);
    box-shadow: inset 0 0 0 1px var(--edge);
    interpolate-size: allow-keywords;
  }
  summary {
    list-style: none;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto 28px;
    align-items: center;
    gap: 16px;
    padding: 22px 24px;
    border-radius: 24px;
    cursor: pointer;
    transition: scale 160ms var(--ease-out);
  }
  summary::-webkit-details-marker { display: none; }
  summary:active { scale: 0.99; }
  summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .no { color: var(--dim); font-size: 14px; font-variant-numeric: tabular-nums; }
  .name {
    font-weight: 300;
    font-size: clamp(28px, 3vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--bright);
  }
  .platform {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--wash-2);
    color: var(--ink);
    font-size: 14px;
    font-weight: 400;
    white-space: nowrap;
  }
  /* A plus that turns into a minus: two strokes, one of them rotating flat. */
  .chev { position: relative; width: 14px; height: 14px; justify-self: end; }
  .chev::before,
  .chev::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    margin-top: -0.75px;
    border-radius: 2px;
    background: var(--muted);
    transition: transform 200ms var(--ease-out);
  }
  .chev::after { transform: rotate(90deg); }
  .game[open] .chev::after { transform: rotate(0deg); }

  /* Opening: height and opacity together, 250ms on the strong ease-out; browsers without ::details-content simply open. */
  .game::details-content {
    block-size: 0;
    opacity: 0;
    overflow: clip;
    transition: block-size 250ms var(--ease-out), opacity 250ms var(--ease-out), content-visibility 250ms allow-discrete;
  }
  .game[open]::details-content { block-size: auto; opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .game::details-content { transition: none; }
  }

  .body {
    display: grid;
    gap: 20px;
    justify-items: start;
    padding: 0 24px 26px calc(24px + 40px + 16px);
  }
  .desc { max-width: 52ch; color: var(--muted); font-size: 17px; }
  .play { height: 44px; padding: 0 20px; font-size: 15px; }

  @media (hover: hover) and (pointer: fine) {
    summary:hover .chev::before,
    summary:hover .chev::after { background: var(--bright); }
  }
  @media (max-width: 560px) {
    summary { grid-template-columns: minmax(0, 1fr) auto 20px; padding: 18px; gap: 12px; }
    .no { display: none; }
    .body { padding: 0 18px 22px; }
  }
</style>
