---
// When a variation is shown inside the picker (/b1/variants/), keystrokes land
// in the frame, not the picker. Hand the picker's keys up to it.
---

<script is:inline>
  if (window.parent !== window) {
    document.addEventListener('keydown', (e) => {
      if (/^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName) || e.target.isContentEditable) return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (/^[1-9]$/.test(e.key) || e.key === 'ArrowLeft' || e.key === 'ArrowRight' || e.key === 'r' || e.key === 'R') {
        window.parent.postMessage({ protoKey: e.key }, location.origin);
      }
    });
  }
</script>
